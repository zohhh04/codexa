# Copy to .env files; never commit real secrets.
# Backend (backend/.env)
PORT=5000
CLIENT_URL=http://localhost:2000
NODE_ENV=development
# Phase 6 (compile + run toolchains — check with: npm run toolchains):
# CLANG_PATH=clang++  # path to clang++ binary; defaults to 'clang++' on PATH
# CLANG_C_PATH=clang  # C compiler; defaults to 'clang' (falls back to CLANG_PATH)
# JAVAC_PATH=javac    # JDK compiler; install Temurin/Oracle JDK 17+ and add to PATH
# JAVA_PATH=java      # Java runtime (same JDK)
# PYTHON_PATH=python  # Python 3.10+ (python.org or Store), add to PATH
# NODE_PATH=node      # Node.js 20+ for JavaScript execution
# Windows one-shot install: node backend/scripts/setup-toolchains.js --install
# Phase 7 (AI tutor + code generation — optional, offline builders work without it):
# FREE: paste a Gemini key from https://aistudio.google.com (starts with AIza)
# and it is auto-detected — no other setting needed.
# AI_API_KEY=AIza-your-free-gemini-key-here
# Or any OpenAI-compatible provider:
# AI_API_KEY=your-api-key-here
# AI_MODEL=gpt-4o-mini  # any OpenAI-compatible model (auto: gemini-2.0-flash for Gemini keys)
# AI_BASE_URL=https://api.openai.com/v1  # or your provider's base URL
# Phase 9:
MONGODB_URI=mongodb://127.0.0.1:27017/codexa
# JWT_SECRET=generate-with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Frontend (frontend/.env) — only VITE_ prefixed vars are exposed to the browser.
# VITE_API_URL=/api

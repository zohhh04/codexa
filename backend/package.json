{
  "name": "codexa-backend",
  "version": "0.1.0",
  "description": "Codexa AI Express backend — Phase 1 foundation",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:setup": "node scripts/setup-db.js",
    "toolchains": "node scripts/setup-toolchains.js --check",
    "toolchains:install": "node scripts/setup-toolchains.js --install",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.1",
    "morgan": "^1.10.0",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=20"
  }
}
